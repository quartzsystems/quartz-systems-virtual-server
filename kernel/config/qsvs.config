# QS/VS kernel fragment. Merged onto arch/x86/configs/x86_64_defconfig
# after the pipeline's baseline (EFI stub, baked command line, embedded
# initramfs, xz, devtmpfs, proc, sysfs, tmpfs; no modules, no debug
# information), then resolved with `make olddefconfig`. The orchestrator
# checks the final .config symbol by symbol (tools/build/src/product/kernel.rs).

CONFIG_64BIT=y
CONFIG_LOCALVERSION="-qsvs"
# CONFIG_LOCALVERSION_AUTO is not set

# The initramfs is embedded uncompressed and the whole image compressed
# once with xz, which keeps the media UKI under the 32 MiB an El Torito
# boot image can name. No other decompressor is needed.
# CONFIG_KERNEL_GZIP is not set
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# The image does not carry its own configuration: its bytes do not
# depend on where it was built.
# CONFIG_IKCONFIG is not set

# Hypervisor: KVM on both vendors, and what a partition's virtio-net
# needs of the host (vhost-net over tap devices). The VMM's ioeventfds
# and irqfds need eventfd, and the IRQ bypass manager comes with KVM.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_EVENTFD=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=y
CONFIG_TUN=y

# Networking core: the QSI server listens on TCP, and the VMM processes
# talk to their supervisor over Unix sockets.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# Virtual Ethernet: VLAN-aware bridges for the partitions, 802.1Q
# trunks and bonds on the physical side.
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_BONDING=y

# Resource control: one cgroup per partition for processors (cpusets,
# CFS shares and bandwidth), memory and tasks; huge pages to back
# partition memory; seccomp filters around each VMM process.
CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
# A partition's processor is a host core: with SMT its two threads are
# the partition's alone while it runs on it (core scheduling), and a
# VMM maps no more huge pages than its partition was given.
CONFIG_SCHED_SMT=y
CONFIG_SCHED_CORE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Storage: pools are xfs, virtual disks raw files on them; software RAID
# is presented through a ublk block device, which needs io_uring. Disks
# are NVMe, SATA or SCSI.
CONFIG_XFS_FS=y
CONFIG_BLK_DEV_UBLK=y
CONFIG_IO_URING=y
CONFIG_PCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# Scan in the foreground: disks behind an HBA keep their order from boot
# to boot, and tape nodes exist once SCSI is up.
# CONFIG_SCSI_SCAN_ASYNC is not set
# SAS and RAID HBAs on real servers, the set QS/400 enables. MegaRAID:
# Dell PERC H330/H730/H740 and LSI 3008/3108/3508, needed in HBA mode too
# (the test machine is a Dell with a PERC H330 in HBA mode). mpt3sas:
# Dell HBA330, LSI 9300/9400 IT mode. smartpqi and hpsa: Microchip and
# HPE. aacraid: Adaptec. mpi3mr: Broadcom 9600.
CONFIG_SCSI_LOWLEVEL=y
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_SCSI_SMARTPQI=y
CONFIG_SCSI_HPSA=y
CONFIG_SCSI_AACRAID=y
CONFIG_SCSI_MPI3MR=y
# Tape for partitions: drives, changers through the generic SCSI nodes,
# and Fibre Channel through QLogic HBAs.
CONFIG_CHR_DEV_ST=y
CONFIG_CHR_DEV_SG=y
CONFIG_SCSI_FC_ATTRS=y
CONFIG_SCSI_QLA_FC=y

# The ESP, where an update writes the other slot's UKI, and the firmware
# boot entries that choose the slot. Not in the Phase 0 list; here so
# the disk layout of the locked decisions is usable from the first image.
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFIVAR_FS=y

# Physical NICs: Intel, Broadcom and Mellanox, as QS/400 enables them.
# No firmware is built in.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_I40E=y
CONFIG_ICE=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_BNXT=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y

# Pass-through, enabled now and used in a later phase: VFIO for PCI
# devices behind either vendor's IOMMU, with interrupt remapping.
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y

# Running under QEMU for the tests: the host as a virtio guest.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# The Service Tools console: the VT on the firmware framebuffer through
# simpledrm, the serial port on the UART, a keyboard.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# CONFIG_FB_EFI is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_HID=y

# The base system (Phase 1). The clock is set from the RTC by PID 1 and
# written back by the network service: the RTC class, the CMOS driver,
# its sysfs time and its device node. The kernel does not set the clock
# itself, so there is one place that does.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y
# CONFIG_RTC_HCTOSYS is not set
# The ACPI power button, read as an input event device, starts the
# orderly shutdown.
CONFIG_ACPI_BUTTON=y
# The inventory and the system serial number: the DMI identifiers in
# sysfs and the raw SMBIOS table.
CONFIG_DMI=y
CONFIG_DMIID=y
# PID 1 and the log service take their signals from a descriptor.
CONFIG_SIGNALFD=y

# The installer reads its payload from the installation media: an ISO
# 9660 file system on a CD-ROM (real, QEMU's, or a BMC's virtual media,
# which is a USB CD-ROM) or on a USB stick the image was written to.
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SR=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# Left out, though QS/400 has them: the user and PID namespaces of its
# PASE, its netfilter set and kTLS, dummy links, the guest drivers of
# other hypervisors (VMware, Hyper-V), vsock for its guest agent, the
# TPM and ext4. Nothing but the QSI server listens, so there is no
# packet filter.
# CONFIG_NETFILTER is not set
# CONFIG_EXT4_FS is not set

# Nothing wireless, sound or media.
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
