# QS/VS kernel fragment. Merged onto arch/x86/configs/x86_64_defconfig
# after the pipeline's baseline (EFI stub, baked command line, embedded
# initramfs, xz, devtmpfs, proc, sysfs, tmpfs; no modules, no debug
# information), then resolved with `make olddefconfig`. The orchestrator
# checks the final .config symbol by symbol (tools/build/src/product/kernel.rs).

CONFIG_64BIT=y
CONFIG_LOCALVERSION="-qsvs"
# CONFIG_LOCALVERSION_AUTO is not set

# The initramfs is embedded uncompressed and the whole image compressed
# once with xz, which keeps the media UKI under the 32 MiB an El Torito
# boot image can name. No other decompressor is needed.
# CONFIG_KERNEL_GZIP is not set
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# The image does not carry its own configuration: its bytes do not
# depend on where it was built.
# CONFIG_IKCONFIG is not set

# Hypervisor: KVM on both vendors, and what a partition's virtio-net
# needs of the host (vhost-net over tap devices). The VMM's ioeventfds
# and irqfds need eventfd, and the IRQ bypass manager comes with KVM.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_EVENTFD=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=y
CONFIG_TUN=y

# Processors: 512, the most without CPUMASK_OFFSTACK (defconfig has
# 64), the same as QS/400's: a host has more threads than 64.
CONFIG_NR_CPUS=512

# Networking core: the QSI server listens on TCP, and the VMM processes
# talk to their supervisor over Unix sockets.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# Virtual Ethernet: VLAN-aware bridges for the partitions, 802.1Q
# trunks and bonds on the physical side.
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_BONDING=y
# A partition port's ingress filter (net/nl/src/filter.rs): what the
# bridge itself cannot refuse, BPDUs and a frame tagged with the port's
# own VLAN. tc, not netfilter.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_ACT_GACT=y

# Resource control: one cgroup per partition for processors (cpusets,
# CFS shares and bandwidth), memory and tasks; huge pages to back
# partition memory; seccomp filters around each VMM process.
CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
# A partition's processor is a host core: with SMT its two threads are
# the partition's alone while it runs on it (core scheduling), and a
# VMM maps no more huge pages than its partition was given.
CONFIG_SCHED_SMT=y
CONFIG_SCHED_CORE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Storage: pools are xfs, virtual disks raw files on them; software RAID
# is presented through a ublk block device, which needs io_uring. Disks
# are NVMe, SATA or SCSI.
CONFIG_XFS_FS=y
CONFIG_BLK_DEV_UBLK=y
CONFIG_IO_URING=y
CONFIG_PCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# Scan in the foreground: disks behind an HBA keep their order from boot
# to boot, and tape nodes exist once SCSI is up.
# CONFIG_SCSI_SCAN_ASYNC is not set
# SAS and RAID HBAs on real servers, the set QS/400 enables. MegaRAID:
# Dell PERC H330/H730/H740 and LSI 3008/3108/3508, needed in HBA mode too
# (the test machine is a Dell with a PERC H330 in HBA mode). mpt3sas:
# Dell HBA330, LSI 9300/9400 IT mode. smartpqi and hpsa: Microchip and
# HPE. aacraid: Adaptec. mpi3mr: Broadcom 9600.
CONFIG_SCSI_LOWLEVEL=y
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_SCSI_SMARTPQI=y
CONFIG_SCSI_HPSA=y
CONFIG_SCSI_AACRAID=y
CONFIG_SCSI_MPI3MR=y
# Tape for partitions: drives, changers through the generic SCSI nodes,
# and Fibre Channel through QLogic HBAs.
CONFIG_CHR_DEV_ST=y
CONFIG_CHR_DEV_SG=y
CONFIG_SCSI_FC_ATTRS=y
CONFIG_SCSI_QLA_FC=y

# The ESP, where an update writes the other slot's UKI, and the firmware
# boot entries that choose the slot. Not in the Phase 0 list; here so
# the disk layout of the locked decisions is usable from the first image.
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFIVAR_FS=y

# Physical NICs: Intel, Broadcom and Mellanox, as QS/400 enables them.
# No firmware is built in.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_I40E=y
CONFIG_ICE=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_BNXT=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y

# Pass-through (Phase 10, docs/PHYSICALIO.md): VFIO for PCI devices
# behind either vendor's IOMMU, with interrupt remapping. The IOMMU is on
# at every IPL, whatever is released, and the host's own devices are
# translated too (lazily: the IOTLB is flushed in batches). x2APIC lets
# remapping cover every processor.
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y
CONFIG_X86_X2APIC=y
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
CONFIG_VFIO=y
CONFIG_VFIO_CONTAINER=y
CONFIG_VFIO_PCI=y

# Running under QEMU for the tests: the host as a virtio guest.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# The Service Tools console: the VT on the firmware framebuffer through
# simpledrm, the serial port on the UART, a keyboard.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# CONFIG_FB_EFI is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_HID=y

# The base system (Phase 1). The clock is set from the RTC by PID 1 and
# written back by the network service: the RTC class, the CMOS driver,
# its sysfs time and its device node. The kernel does not set the clock
# itself, so there is one place that does.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y
# CONFIG_RTC_HCTOSYS is not set
# The ACPI power button, read as an input event device, starts the
# orderly shutdown.
CONFIG_ACPI_BUTTON=y
# The inventory and the system serial number: the DMI identifiers in
# sysfs and the raw SMBIOS table.
CONFIG_DMI=y
CONFIG_DMIID=y
# PID 1 and the log service take their signals from a descriptor.
CONFIG_SIGNALFD=y

# The installer reads its payload from the installation media: an ISO
# 9660 file system on a CD-ROM (real, QEMU's, or a BMC's virtual media,
# which is a USB CD-ROM) or on a USB stick the image was written to.
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SR=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# Phase 5: Service Tools imports an image into the media library from a
# removable volume (FAT, exFAT, an ISO 9660 one with long names) or the
# whole of a disc in the host's own optical drive.
CONFIG_JOLIET=y
CONFIG_EXFAT_FS=y

# Left out, though QS/400 has them: the user and PID namespaces of its
# PASE, its netfilter set and kTLS, dummy links, the guest drivers of
# other hypervisors (VMware, Hyper-V), vsock for its guest agent, the
# TPM and ext4. Nothing but the QSI server listens, so there is no
# packet filter.
# CONFIG_NETFILTER is not set
# CONFIG_EXT4_FS is not set

# Nothing wireless, sound or media.
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set

# Hardening (Phase 11, docs/SECURITY.md). The command line stays the
# locked one; everything here is the configuration's.
#
# The kernel's log is root's alone.
CONFIG_SECURITY_DMESG_RESTRICT=y
# Checked copies to and from user memory, and fortified string calls.
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
# The allocators: freelists randomized and checked, kmalloc caches
# randomized, caches not merged, lists checked, corruption a panic.
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_RANDOM_KMALLOC_CACHES=y
# CONFIG_SLAB_MERGE_DEFAULT is not set
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
# Every allocation zeroed, the stack's offset random on each call,
# used registers zeroed on return.
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_ZERO_CALL_USED_REGS=y
# An oops is a panic, and a panic restarts the host (panic=-1); its
# last messages are kept in the firmware's variables for the next IPL.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PSTORE=y
CONFIG_EFI_VARS_PSTORE=y
# What the baseline already has, held here: the kernel's text read-only,
# its stacks guarded and in vmalloc space, its place random, the
# processors' mitigations on.
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_CPU_MITIGATIONS=y
# Ptrace only of a process's own descendants.
CONFIG_SECURITY_YAMA=y
# CONFIG_SECURITY_SELINUX is not set
#
# What a hypervisor host never uses, taken away: another kernel loaded
# or a crash kernel's view of this one, hibernation, the physical
# memory and port devices and /proc/kcore, the I/O port calls (the LDT
# call needs EXPERT to leave out; no VMM may make it, docs/SECURITY.md),
# 32-bit programs and vsyscall, typing into another's terminal, line
# disciplines loaded on demand, binfmt_misc, kprobes and uprobes, the
# firmware's ACPI overlays, the magic SysRq key, debugfs (a test
# image's has it).
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_IA32_EMULATION is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_UPROBES is not set
# CONFIG_EFI_CUSTOM_SSDT_OVERLAYS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_USER_NS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_USERFAULTFD is not set
# The fallback tunnel devices in every new network namespace: none is
# used, and a VMM's namespace has its loopback alone.
# CONFIG_IPV6_SIT is not set
