# The test image's kernel alone (`all --test-image`): never a release's.
# A SCSI tape drive emulated by scsi_debug, the double of a physical
# drive for the tape pass-through suites (docs/PHASE10.md). It makes no
# device until the test hooks ask for one: the test image's command line
# has scsi_debug.add_host=0.
CONFIG_SCSI_DEBUG=y
# The IOMMU's own record of each domain's mappings, read by the isolation
# suite through debugfs (docs/PHASE10.md).
CONFIG_DEBUG_FS=y
CONFIG_IOMMU_DEBUGFS=y
CONFIG_INTEL_IOMMU_DEBUGFS=y
# A kernel panic on demand, for the host panic suite (docs/PHASE11.md):
# LKDTM's provoke-crash in debugfs.
CONFIG_LKDTM=y
